{
  "manifest_version": 3,
  "name": "Piranha Link Guard",
  "description": "Checks links for malicious indicators and manages a personal block list.",
  "version": "1.2.0",
  "host_permissions": ["*://*/*"],
  "permissions": ["storage", "tabs"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "Piranha_Extension_Logo.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
